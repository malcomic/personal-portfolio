# Copy to .env.local and fill in. Never commit real values.

# Neon: pooled connection string (used by the app at runtime)
DATABASE_URL=
# Neon: direct (non-pooled) connection string (used by Prisma migrations)
DIRECT_URL=

# Resend
RESEND_API_KEY=
# Use "Portfolio <onboarding@resend.dev>" until your domain is verified
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Random secret for hashing client IPs (e.g. `openssl rand -base64 32`)
IP_HASH_SALT=

# Dashboard login
ADMIN_EMAIL=
# Generate with `npm run hash-password` (base64-encoded bcrypt hash)
ADMIN_PASSWORD_HASH=
# Random secret for signing session cookies, 32+ characters (e.g. `openssl rand -base64 32`)
SESSION_SECRET=
